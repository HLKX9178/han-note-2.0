<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.hanserwei.dataalign.domain.mapper.DeleteMapper">

    <delete id="batchDeleteFollowingCountTemp">
