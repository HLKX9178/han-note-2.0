# 复制为 application-dev.yml 并填入真实值（真实文件已被 .gitignore 忽略）
spring:
  cloud:
    nacos:
      discovery:
        server-addr: <nacos-addr>
        namespace: hannote
        group: DEFAULT_GROUP

  # PostgreSQL（计数服务复用 hannote 库）
  datasource:
    url: jdbc:postgresql://<pg-host>:5432/hannote
    username: <pg-user>
    password: <pg-password>
    driver-class-name: org.postgresql.Driver
    type: com.zaxxer.hikari.HikariDataSource
    hikari:
      minimum-idle: 5
      maximum-pool-size: 20
      connection-timeout: 60000
      idle-timeout: 300000
      max-lifetime: 900000
      pool-name: HannoteHikariPool

  # Redis（计数缓存预留）
  data:
    redis:
      host: <redis-host>
      port: 6379
      password: <redis-password>
      database: 0
      timeout: 5s
      connect-timeout: 5s
      lettuce:
        pool:
          max-active: 200
          max-wait: -1ms
          min-idle: 0
          max-idle: 10

# RocketMQ（计数增减异步化预留；本期无生产者/消费者，仅备好连接配置）
rocketmq:
  name-server: <rocketmq-name-server>     # 如 127.0.0.1:9876
  producer:
    group: hannote_count_group
    send-message-timeout: 3000            # 消息发送超时时间（毫秒）
    retry-times-when-send-failed: 3       # 同步发送失败重试次数
    retry-times-when-send-async-failed: 3 # 异步发送失败重试次数
    max-message-size: 4096                # 消息最大大小（字节）

logging:
  level:
    com.hanserwei.count.domain.mapper: debug
