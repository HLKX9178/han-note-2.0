<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.hanserwei</groupId>
        <artifactId>hannote</artifactId>
        <version>${revision}</version>
    </parent>

    <artifactId>hannote-search</artifactId>
    <packaging>jar</packaging>

    <name>${project.artifactId}</name>
    <description>hannote 搜索服务：基于 Elasticsearch 的笔记/用户分词搜索。作者：Hanserwei</description>

    <dependencies>
        <!-- 通用响应/异常/工具（Response、PageResponse、NumberUtils、DateUtils 等） -->
        <dependency>
            <groupId>com.hanserwei</groupId>
            <artifactId>hannote-common</artifactId>
        </dependency>
        <!-- 业务接口日志组件（@ApiOperationLog） -->
        <dependency>
            <groupId>com.hanserwei</groupId>
            <artifactId>hannote-spring-boot-starter-biz-operationlog</artifactId>
        </dependency>

        <!-- Web 服务 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- 参数校验运行时（@Validated 需要） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Elasticsearch 官方新 Java 客户端 -->
        <dependency>
            <groupId>co.elastic.clients</groupId>
            <artifactId>elasticsearch-java</artifactId>
        </dependency>

        <!-- 字符串工具（StringUtils） -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-lang3</artifactId>
        </dependency>

        <!-- 服务发现 -->
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-discovery</artifactId>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
        </dependency>

        <!-- 测试 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
