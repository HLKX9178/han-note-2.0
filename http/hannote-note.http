### 22. 取消未收藏的笔记应返回 NOTE-20011 —— 环境 note-direct
# 重要：本用例必须针对「该用户【从未收藏过】的笔记」。
# 布隆过滤器不支持删除：一旦收藏过某笔记，布隆会永久标记它，之后即使取消收藏，
# 再调本接口也会命中「误判可容忍」分支、幂等返回 success。
# 因此请：在 #19 收藏【之前】先跑本用例，或把下面 id 换成一个 68001 从未收藏过的笔记 ID。
POST {{noteHost}}{{noteBasePath}}/note/uncollect
Content-Type: application/json
userId: {{userId}}

{
  "id": {{noteId}}
}

> {%
    client.test("取消未收藏被拦截", function () {
        client.assert(response.body.success === false, "预期 success=false（需针对从未收藏过的笔记）");
        client.assert(response.body.errorCode === "NOTE-20011", "预期 NOTE-20011，实际 " + response.body.errorCode);
    });
%}

### 23. 查询当前用户是否点赞/收藏某笔记 —— 环境 note-direct
# 点赞/收藏判重已由布隆过滤器改为 Roaring Bitmap（R64.GETBIT，精确判断，无需 DB 二次校验）
POST {{noteHost}}{{noteBasePath}}/note/isLikedAndCollectedData
Content-Type: application/json
userId: {{userId}}

{
  "noteId": {{noteId}}
}

> {%
    client.test("查询点赞/收藏状态成功", function () {
        client.assert(response.status === 200, "HTTP 状态非 200");
        client.assert(response.body.success === true, "success 非 true：" + JSON.stringify(response.body));
        client.assert(response.body.data && response.body.data.hasOwnProperty("isLiked"), "返参缺 isLiked 字段");
        client.assert(response.body.data && response.body.data.hasOwnProperty("isCollected"), "返参缺 isCollected 字段");
    });
%}
