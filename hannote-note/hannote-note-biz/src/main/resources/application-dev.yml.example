# 复制为 application-dev.yml 并填入真实值（真实文件已被 .gitignore 忽略）
spring:
  cloud:
    nacos:
      discovery:
        server-addr: <nacos-addr>
        namespace: hannote
        group: DEFAULT_GROUP

  # PostgreSQL（笔记服务所属数据库 hannote）
  datasource:
    url: jdbc:postgresql://<pg-host>:5432/hannote
    username: <pg-user>
    password: <pg-password>
    driver-class-name: org.postgresql.Driver

  # Redis（笔记详情缓存等）
  data:
    redis:
      host: <redis-host>
      port: 6379
      password: <redis-password>
      database: 0
      timeout: 5s
      connect-timeout: 5s
      lettuce:
        pool:
          max-active: 200
          max-wait: -1ms
          min-idle: 0
          max-idle: 10

# RocketMQ（广播删本地缓存 + 延迟双删 Redis 缓存）
rocketmq:
  name-server: <rocketmq-name-server>     # 如 127.0.0.1:9876
  producer:
    group: hannote_group
    send-message-timeout: 3000            # 消息发送超时时间（毫秒）
    retry-times-when-send-failed: 3       # 同步发送失败重试次数
    retry-times-when-send-async-failed: 3 # 异步发送失败重试次数
    max-message-size: 4096                # 消息最大大小（字节）
  consumer:
    group: hannote_group
    pull-batch-size: 5                    # 每次拉取的最大消息数

logging:
  level:
    com.hanserwei.note.domain.mapper: debug
