<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.hanserwei.note.domain.mapper.NoteDOMapper">

    <!-- 查询正常展示中的笔记发布者 ID（status = 1）；不存在返回 null -->
    <select id="selectCreatorIdByNoteId" resultType="java.lang.Long">
        SELECT creator_id
        FROM t_note
        WHERE id = #{noteId}
          AND status = 1
    </select>

    <select id="selectPublishedById" resultType="com.hanserwei.note.api.dto.resp.FindPublishedNoteRspDTO">
        SELECT id AS note_id, creator_id
        FROM t_note
        WHERE id = #{noteId}
          AND status = 1
    </select>

    <!-- 游标分页查询博主已发布笔记：公开(visible=0) + 正常展示(status=1)，按 ID 降序，每页 20 条 -->
    <select id="selectPublishedNoteListByUserIdAndCursor" resultType="com.hanserwei.note.domain.dataobject.NoteDO">
        SELECT id, title, creator_id, type, img_uris, video_uri
        FROM t_note
        WHERE creator_id = #{creatorId}
          AND visible = 0
          AND status = 1
        <if test="cursor != null">
            <![CDATA[ AND id < #{cursor} ]]>
        </if>
        ORDER BY id DESC
        LIMIT 20
    </select>

</mapper>
