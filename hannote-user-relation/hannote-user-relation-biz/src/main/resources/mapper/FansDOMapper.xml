<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.hanserwei.relation.domain.mapper.FansDOMapper">

    <!--
      批量插入粉丝记录（PostgreSQL）。命中 (user_id, fans_user_id) 唯一索引
      uk_fans_user_fans 则 DO NOTHING，保证重复消费幂等。
    -->
    <insert id="batchInsertIgnore" parameterType="list">
        INSERT INTO t_fans (user_id, fans_user_id, create_time)
        VALUES
        <foreach collection="list" item="item" separator=",">
            (#{item.userId}, #{item.fansUserId}, #{item.createTime})
        </foreach>
        ON CONFLICT (user_id, fans_user_id) DO NOTHING
    </insert>

    <!--
      批量删除粉丝记录，按 (user_id, fans_user_id) 组合逐对匹配。
    -->
    <delete id="batchDelete" parameterType="list">
        DELETE FROM t_fans WHERE
        <foreach collection="list" item="item" separator=" OR ">
            (user_id = #{item.userId} AND fans_user_id = #{item.fansUserId})
        </foreach>
    </delete>

</mapper>
