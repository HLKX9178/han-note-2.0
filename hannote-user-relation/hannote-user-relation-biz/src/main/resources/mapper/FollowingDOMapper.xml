<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.hanserwei.relation.domain.mapper.FollowingDOMapper">

    <!--
      批量插入关注记录（PostgreSQL）。命中 (user_id, following_user_id) 唯一索引
      uk_following_user_following 则 DO NOTHING，保证重复消费幂等。
    -->
    <insert id="batchInsertIgnore" parameterType="list">
        INSERT INTO t_following (user_id, following_user_id, create_time)
        VALUES
        <foreach collection="list" item="item" separator=",">
            (#{item.userId}, #{item.followingUserId}, #{item.createTime})
        </foreach>
        ON CONFLICT (user_id, following_user_id) DO NOTHING
    </insert>

    <!--
      批量删除关注记录，按 (user_id, following_user_id) 组合逐对匹配。
      用行值构造器 IN 而非 OR 串联：PG 可直接走 uk_following_user_following 索引，
      避免 batchSize 个 OR 子句导致的查询计划劣化。
    -->
    <delete id="batchDelete" parameterType="list">
        DELETE FROM t_following WHERE (user_id, following_user_id) IN
        <foreach collection="list" item="item" open="(" separator="," close=")">
            (#{item.userId}, #{item.followingUserId})
        </foreach>
    </delete>

</mapper>
