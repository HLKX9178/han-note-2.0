# 复制为 application-dev.yml 并填入真实值（真实文件已被 .gitignore 忽略）
spring:
  cloud:
    nacos:
      discovery:
        server-addr: <nacos-addr>
        namespace: hannote
        group: DEFAULT_GROUP

  # PostgreSQL（用户关系服务复用 hannote 库）
  datasource:
    url: jdbc:postgresql://<pg-host>:5432/hannote
    username: <pg-user>
    password: <pg-password>
    driver-class-name: org.postgresql.Driver

  # Redis（关注/粉丝缓存预留）
  data:
    redis:
      host: <redis-host>
      port: 6379
      password: <redis-password>
      database: 0
      timeout: 5s
      connect-timeout: 5s
      lettuce:
        pool:
          max-active: 200
          max-wait: -1ms
          min-idle: 0
          max-idle: 10

logging:
  level:
    com.hanserwei.relation.domain.mapper: debug
