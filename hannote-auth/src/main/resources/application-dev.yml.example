# 复制为 application-dev.yml 并通过环境变量提供真实值（该真实文件已被 .gitignore 忽略）
# 需要的环境变量：REDIS_HOST REDIS_PORT REDIS_PASSWORD NACOS_HOST NACOS_PORT
spring:
  cloud:
    nacos:
      discovery:
        server-addr: ${NACOS_HOST}:${NACOS_PORT}
        namespace: ${NACOS_NAMESPACE:public}
        group: ${NACOS_GROUP:DEFAULT_GROUP}
  data:
    redis:
      database: 0
      host: ${REDIS_HOST}
      port: ${REDIS_PORT}
      password: ${REDIS_PASSWORD}
      timeout: 5s
      connect-timeout: 5s
      lettuce:
        pool:
          max-active: 200
          max-wait: -1ms
          min-idle: 0
          max-idle: 10

# 阿里云短信认证服务（AccessKey 在阿里云控制台创建）
aliyun:
  access-key-id: ${ALIYUN_ACCESS_KEY_ID}
  access-key-secret: ${ALIYUN_ACCESS_KEY_SECRET}
  sms:
    sign-name: ${ALIYUN_SMS_SIGN_NAME:}
    template-code: ${ALIYUN_SMS_TEMPLATE_CODE:}

# JWT 配置（密钥必须 >= 32 字节，仅本地使用，勿入库）
hannote:
  jwt:
    secret: ${JWT_SECRET}
    expiration: 2592000
