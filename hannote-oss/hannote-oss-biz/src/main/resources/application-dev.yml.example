# 复制为 application-dev.yml 并填入真实值（真实文件已被 .gitignore 忽略）
spring:
  cloud:
    nacos:
      discovery:
        server-addr: 101.43.61.11:18848
        namespace: hannote
        group: DEFAULT_GROUP

# 对象存储类型：rustfs | tencent-cos
storage:
  type: rustfs

# Rustfs 对象存储配置（S3 兼容，用 AWS S3 SDK v2 对接）
rustfs:
  endpoint: http://127.0.0.1:9000 # Rustfs 服务地址
  access-key: xxx # 访问密钥
  secret-key: xxx # 秘密密钥
  region: us-east-1 # 区域，Rustfs 不校验，可写死
  bucket: hannote # 默认存储桶名称

# 腾讯云 COS 对象存储配置
tencent:
  cos:
    secret-id: xxx
    secret-key: xxx
    region: ap-guangzhou
    bucket: hannote-1250000000 # 桶名含 APPID 后缀
    custom-domain: # 可选，自定义访问域名（如 https://note.example.com），留空则用 COS 默认域名
